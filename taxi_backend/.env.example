# Backend service environment example

# Server port
PORT=3001

# Database connection URL (PostgreSQL DSN)
# Example: postgresql://user:password@host:port/dbname
# If not set, backend will attempt to read from ../rideconnect-taxi-service-221447-221468/database/db_connection.txt
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taxi

# JWT secret used for signing tokens
JWT_SECRET=change-me-super-secret

# CORS allowed origins (comma separated)
# Default is http://localhost:3000 for the Svelte frontend
CORS_ORIGINS=http://localhost:3000

# Fare configuration with defaults if unset
FARE_BASE=3.0
FARE_PER_KM=1.2
FARE_PER_MIN=0.3

# Payment provider selection (fake|stripe|adyen...) - currently only "fake" implemented
PAYMENT_PROVIDER=fake

# Socket.IO specific CORS origins (comma separated). Defaults to "*"
# SOCKETIO_CORS_ORIGINS=http://localhost:3000
